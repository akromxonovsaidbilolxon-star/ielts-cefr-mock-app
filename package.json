{
  "name": "ielts-cefr-mock-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "IELTS mock exam app with CEFR level estimation — Listening, Reading, Writing and Speaking",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "preflight": "node scripts/preflight.mjs",
    "audio:manifest": "node scripts/audio-manifest.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
